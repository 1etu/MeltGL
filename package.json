{
  "name": "meltgl-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @meltgl/demonstration dev",
    "host": "pnpm --filter @meltgl/test-host dev",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "turbo run test",
    "bench": "pnpm --filter @meltgl/benchmark start",
    "clean": "turbo run clean && rimraf node_modules",
    "bundle": "node Tools/Build/src/bundle.mjs",
    "site": "node Tools/Build/src/bundle.mjs && node Tools/Build/src/site.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "esbuild": "^0.24.2"
  }
}
