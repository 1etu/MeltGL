{
  "name": "@meltgl/displacement-engine",
  "version": "0.1.0",
  "description": "Displacement passes",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@meltgl/common": "workspace:*",
    "@meltgl/noise-generator": "workspace:*",
    "@meltgl/render-pipeline": "workspace:*"
  }
}
